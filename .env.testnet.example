# Copy this file to .env, then fill only sandbox/demo credentials.
# Do not put production API keys in this testnet template.

KXIAN_MODE=testnet
KXIAN_EXCHANGE=binance
KXIAN_SYMBOL=BTCUSDT
KXIAN_INTERVAL=4h
KXIAN_USE_TESTNET=true
KXIAN_MARKET_DATA_SOURCE=exchange

# Binance Spot Testnet credentials from https://testnet.binance.vision/
KXIAN_BINANCE_API_KEY=
KXIAN_BINANCE_API_SECRET=

# Keep this false until `kxian-bot testnet-setup-check`,
# `kxian-bot readiness`, and `kxian-bot testnet-dry-run` pass.
KXIAN_ENABLE_TESTNET_AUTOTRADE=false

# Never enable live switches in a testnet .env.
KXIAN_ALLOW_LIVE=false
KXIAN_LIVE_DRY_RUN=true
KXIAN_ENABLE_LIVE_AUTOTRADE=false
KXIAN_LIVE_CONFIRMATION=

# Conservative default order/risk controls for sandbox observation.
KXIAN_MAX_POSITION_USDT=300
KXIAN_MIN_ORDER_USDT=10
KXIAN_RISK_PER_TRADE=0.1
KXIAN_MAX_DAILY_LOSS_USDT=100
KXIAN_MAX_DAILY_TRADES=20
KXIAN_MAX_CONSECUTIVE_LOOP_ERRORS=3
